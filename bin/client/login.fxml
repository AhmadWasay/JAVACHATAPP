<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="client.LoginController" styleClass="main-background" alignment="CENTER">

    <VBox alignment="CENTER_LEFT" spacing="10" maxWidth="600" HBox.hgrow="ALWAYS" style="-fx-padding: 0 0 0 100;">
        <Label text="Java Chat" styleClass="brand-logo"/>
        <Label text="Connect with the world around you on Java Chat." 
               wrapText="true" styleClass="brand-tagline" maxWidth="500"/>
    </VBox>

    <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
        <StackPane>
            <VBox fx:id="loginPane" alignment="CENTER" spacing="15.0" maxWidth="380" styleClass="login-card">
                
                <TextField fx:id="ipField" promptText="Server IP Address" text="localhost" styleClass="input-field"/>
                
                <TextField fx:id="loginUserField" promptText="Username" styleClass="input-field"/>
                <PasswordField fx:id="loginPassField" promptText="Password" styleClass="input-field"/>
                
                <Button fx:id="loginBtn" text="Link Start" maxWidth="Infinity" styleClass="btn-primary"/>
                
                <Hyperlink fx:id="forgotPasswordLink" text="Forgot password?" styleClass="link-blue"/>
                
                <Separator maxWidth="300" style="-fx-padding: 10 0;"/>
                
                <Button fx:id="goToRegisterBtn" text="Create New Account" styleClass="btn-green"/>
            </VBox>

            <VBox fx:id="registerPane" visible="false" alignment="CENTER" spacing="15.0" maxWidth="380" styleClass="login-card">
                <Label text="Sign Up" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="It's quick and easy." style="-fx-text-fill: #606770; -fx-font-size: 14px;"/>
                
                <Separator maxWidth="340"/>

                <TextField fx:id="regUserField" promptText="Username" styleClass="input-field"/>
                <TextField fx:id="regEmailField" promptText="Email Address" styleClass="input-field"/>
                <PasswordField fx:id="regPassField" promptText="New Password" styleClass="input-field"/>
                
                <Label text="By clicking Sign Up, you agree to our Terms." wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #777;" maxWidth="340"/>

                <Button fx:id="registerBtn" text="Sign Up" maxWidth="200" styleClass="btn-green"/>
                <Hyperlink fx:id="backToLoginBtn1" text="Already have an account?" styleClass="link-blue"/>
            </VBox>

            <VBox fx:id="otpPane" visible="false" alignment="CENTER" spacing="15.0" maxWidth="380" styleClass="login-card">
                <Label text="Verify Account" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Enter your email to receive a code." style="-fx-text-fill: #606770;"/>
                
                <TextField fx:id="otpEmailField" promptText="Email Address" styleClass="input-field"/>
                
                <Button fx:id="sendOtpBtn" text="Send Code" maxWidth="Infinity" styleClass="btn-primary"/>
                <Button fx:id="backToLoginBtn2" text="Cancel" styleClass="btn-secondary"/>
            </VBox>
        </StackPane>
    </VBox>

    <Label fx:id="globalErrorLabel" text="Error Message" visible="false" 
           style="-fx-background-color: #fa3e3e; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5; -fx-font-weight: bold;"
           translateX="-50" translateY="-50"/>
</HBox>